<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小组件外层玻璃。

  层级（从下到上，规范 §12「局部对比度保护」）：
    壁纸 → 深色半透明玻璃(#6B0F1720, 0.42) → 对角白光渐变 → 顶部高光 → 白色轮廓

  透明度和模糊的取舍：
  · 规范里的 backdrop-filter: blur(24px) 在 RemoteViews 上**无法实现**——小组件运行时
    不能跑着色器，框架也不给模糊。这里靠"加深底色 + 加高光"来补足空间感，
    也是在复杂壁纸上仍然读得清的关键。
  · 不用纯黑/不透明，壁纸始终透得出来（0.42 透明度）。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ① 深色中性玻璃底 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#6B0F1720" />
        </shape>
    </item>

    <!-- ② 对角白光：linear-gradient(135deg, rgba(255,255,255,.13), rgba(255,255,255,.045)) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient android:type="linear" android:angle="315">
                <item android:offset="0" android:color="#21FFFFFF" />
                <item android:offset="1" android:color="#0BFFFFFF" />
            </gradient>
        </shape>
    </item>

    <!-- ③ 顶部内高光：对应 inset 0 1px 0 rgba(255,255,255,.24) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient android:type="linear" android:angle="270">
                <item android:offset="0" android:color="#33FFFFFF" />
                <item android:offset="0.45" android:color="#0DFFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </shape>
    </item>

    <!-- ④ 玻璃轮廓。
         规范想要"顶部 0.28 / 普通 0.18 / 底部黑色 0.10"三档，
         但 Android 的 <stroke> 是四边同色、无法分边，这里取中间的 0.18；
         顶部的提亮由上面的③高光承担。 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#2EFFFFFF" />
        </shape>
    </item>
</layer-list>
