<?xml version="1.0" encoding="utf-8"?>
<!--
  1x1 他人使用中：整块变橙。

  橙色而不是红色——设备是好的、你也确实能用，只是**现在**不是你的，
  等对方用完就行。用红色会像出了故障。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#CCB45309" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient android:type="linear" android:angle="315">
                <item android:offset="0" android:color="#33FFFFFF" />
                <item android:offset="1" android:color="#0DFFFFFF" />
            </gradient>
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#3DFFFFFF" />
        </shape>
    </item>
</layer-list>
