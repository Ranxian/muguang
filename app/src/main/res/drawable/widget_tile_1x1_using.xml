<?xml version="1.0" encoding="utf-8"?>
<!--
  1x1 使用中：整块变蓝。

  1x1 上没有地方放「已用时长」这类文字，所以**状态全靠底色表达**——
  蓝色 = 你正在用，点一下关阀。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#CC2563EB" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient android:type="linear" android:angle="315">
                <item android:offset="0" android:color="#33FFFFFF" />
                <item android:offset="1" android:color="#0DFFFFFF" />
            </gradient>
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#3DFFFFFF" />
        </shape>
    </item>
</layer-list>
