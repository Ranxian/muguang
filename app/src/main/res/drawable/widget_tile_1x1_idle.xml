<?xml version="1.0" encoding="utf-8"?>
<!--
  1x1 空闲态：和 2x2 / 2x4 同一套深色玻璃，只是圆角小一点。
  22dp 的圆角放在四五十 dp 的方块上会圆成一个球，所以这里用 18dp。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#6B0F1720" />
        </shape>
    </item>

    <!-- 对角白光 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient android:type="linear" android:angle="315">
                <item android:offset="0" android:color="#21FFFFFF" />
                <item android:offset="1" android:color="#0BFFFFFF" />
            </gradient>
        </shape>
    </item>

    <!-- 顶部内高光 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient android:type="linear" android:angle="270">
                <item android:offset="0" android:color="#33FFFFFF" />
                <item android:offset="0.45" android:color="#0DFFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#2EFFFFFF" />
        </shape>
    </item>
</layer-list>
